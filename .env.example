# Copy this file to .env and fill in the values. .env is git-ignored, so the
# keys stay on this machine. Never commit or share real keys.
#
# With live.testnet: true (the default) these must be Binance SPOT TESTNET keys
# from https://testnet.binance.vision — keys from your normal account won't work.
# Give the key trading permission only. Never enable withdrawals.
EXCHANGE_API_KEY=
EXCHANGE_API_SECRET=

# The last lock. Uncomment only when you have decided to send orders, and also
# set live.dry_run: false in config.yaml.
# LIVE_CONFIRM=I_UNDERSTAND_THE_RISK

# Optional: password for /admin/feedback when the desk runs on a server
# ADMIN_TOKEN=
